---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact — Sustainabox | Book a Stay or Schedule a Call" description="Get in touch with Jen and Cody at Sustainabox. Book your weekend stay, schedule a free consulting call, or ask about courses and digital tools.">

	<header class="page-hero" style="background-image: url('/images/deck.jpeg');">
		<div class="page-hero-inner">
			<span class="eyebrow">Contact</span>
			<h1>Get in Touch</h1>
			<p>Questions about a stay, the walkthrough, or your own build? Let's talk.</p>
		</div>
	</header>

	<section class="container content-section">
		<div class="contact-box">
			<h2>Reach Out</h2>
			<p>Email us to:</p>
			<ul>
				<li>Check availability and book a stay</li>
				<li>Ask about the 4-hour walkthrough</li>
				<li>Inquire about the course or design tools</li>
				<li>Anything else</li>
			</ul>
			<p style="margin-top: 2rem;">
				<strong><a href="mailto:jenswid@gmail.com,codyswid@gmail.com?subject=Sustainabox%20Inquiry" style="color: var(--color-blue); text-decoration: none; font-size: 1.2rem;">Email the Sustainabox Team</a></strong>
			</p>
			<p style="color: var(--color-muted); margin-top: 1rem;">We'll respond within 24 hours. Coming soon: hello@sustainabox.org</p>
		</div>
	</section>

</Layout>

<style>
	.content-section {
		padding: 4rem 0;
	}

	.contact-box {
		background: var(--color-warm);
		padding: 3rem;
		border-radius: 12px;
		max-width: 500px;
		margin: 0 auto;
		text-align: center;
		border-left: 4px solid var(--color-blue);
	}

	.contact-box h2 {
		margin-bottom: 1.5rem;
	}

	.contact-box p {
		font-size: 1rem;
		margin-bottom: 1rem;
	}

	.contact-box ul {
		list-style: none;
		padding: 0;
		text-align: left;
		display: inline-block;
	}

	.contact-box li {
		padding: 0.5rem 0;
		padding-left: 1.5rem;
		position: relative;
	}

	.contact-box li::before {
		content: "✓";
		position: absolute;
		left: 0;
		color: var(--color-blue);
		font-weight: 700;
	}
</style>
