---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sustainabox — Resilience Designed. Built Real.">

	<!-- Hero Slider -->
	<header class="hero-slider-section">
		<div class="hero-slider">
			<!-- Slide 1: The Place -->
			<div class="hero-slide active" style="background: url('/images/PXL_20260513_152354256~2.jpg.jpeg') center/cover no-repeat;">
				<div class="hero-overlay">
					<div class="hero-content">
						<span class="hero-eyebrow">Texas Hill Country</span>
						<h1>Stay in a Container Home, Reimagined</h1>
						<p class="hero-sub">Three containers. 750 sq ft of intention. 1,280 sq ft of deck.</p>
						<a href="/book" class="btn btn-white">Book Your Stay</a>
					</div>
				</div>
			</div>

			<!-- Slide 2: The Hook -->
			<div class="hero-slide" style="background: url('/images/crane over lake.jpg') center/cover no-repeat;">
				<div class="hero-overlay">
					<div class="hero-content">
						<span class="hero-eyebrow">Included With Every Stay</span>
						<h1>A Four-Hour Walkthrough</h1>
						<p class="hero-sub">Foundation to finishes. What worked, what we'd change, and why — the honest version.</p>
						<a href="/stays" class="btn btn-white">Explore the Stay</a>
					</div>
				</div>
			</div>

			<!-- Slide 3: Travel365 -->
			<div class="hero-slide" style="background: url('/images/Elevation 1.jpg') center/cover no-repeat;">
				<div class="hero-overlay">
					<div class="hero-content">
						<span class="hero-eyebrow">Travel365</span>
						<h1>Built to Move. Designed to Last.</h1>
						<p class="hero-sub">Mobile by design. A home that goes where you go.</p>
						<a href="/vision" class="btn btn-white">Our Vision</a>
					</div>
				</div>
			</div>

			<!-- Slide 4: Brand -->
			<div class="hero-slide" style="background: url('/images/PXL_20260619_013004398.jpg') center/cover no-repeat;">
				<div class="hero-overlay">
					<div class="hero-content">
						<span class="hero-eyebrow">Sustainabox</span>
						<h1>Resilience, Designed. Built Real.</h1>
						<p class="hero-sub">Modern comfort. Smart systems. No roughing it.</p>
						<a href="/book" class="btn btn-white">Book Your Stay</a>
					</div>
				</div>
			</div>

			<!-- Navigation -->
			<button class="hero-slider-btn hero-slider-prev" aria-label="Previous slide">❮</button>
			<button class="hero-slider-btn hero-slider-next" aria-label="Next slide">❯</button>

			<!-- Indicators -->
			<div class="hero-slider-indicators">
				<button class="hero-indicator active" data-slide="0" aria-label="Go to slide 1"></button>
				<button class="hero-indicator" data-slide="1" aria-label="Go to slide 2"></button>
				<button class="hero-indicator" data-slide="2" aria-label="Go to slide 3"></button>
				<button class="hero-indicator" data-slide="3" aria-label="Go to slide 4"></button>
			</div>

			<!-- Pause Button -->
			<button class="hero-slider-pause" aria-label="Pause slideshow">⏸</button>
		</div>
	</header>

	<!-- Story -->
	<section class="story-section">
		<div class="container">
			<div class="story-layout">
				<div class="story-text">
					<span class="eyebrow">The Story</span>
					<h2>Built by people who actually build.</h2>
					<p>Jen spent 7 years in homebuilding and general contracting — managing our Colorado build, then consulting for a major builder. Cody brought 15+ years of enterprise resilience. Together we turned three shipping containers and a piece of raw land into a home designed for efficiency, durability, and adaptability.</p>
					<p>It isn't off-grid — it's better. Municipal water, septic, and power, paired with resilience principles and real comfort. No generator drama. Just smart design. Now we're opening it up: to stay in, to learn from, to experience.</p>
				</div>
				<div class="story-image">
					<img src="/images/PXL_20260619_013004398.jpg" alt="Sustainabox exterior in the Texas Hill Country" />
				</div>
			</div>
		</div>
	</section>

	<!-- The Experience -->
	<section class="experience-section">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow">The Experience</span>
				<h2>Every stay is more than a place to sleep.</h2>
			</div>
			<div class="experience-grid">
				<div class="experience-item">
					<span class="exp-num">01</span>
					<h3>The Four-Hour Walkthrough</h3>
					<p>A guided tour of every system — what worked, what we'd change, and why. Hosted when we're home, on video when we're traveling.</p>
				</div>
				<div class="experience-item">
					<span class="exp-num">02</span>
					<h3>1,280 Sq Ft of Open Air</h3>
					<p>An expansive deck under big Hill Country skies. Morning coffee, evening quiet, room to breathe.</p>
				</div>
				<div class="experience-item">
					<span class="exp-num">03</span>
					<h3>Modern Comfort, Smart Design</h3>
					<p>Grid-connected water, septic, and power. Climate-controlled, considered, and genuinely comfortable.</p>
				</div>
				<div class="experience-item">
					<span class="exp-num">04</span>
					<h3>Knowledge to Take Home</h3>
					<p>Design documentation, honest answers, and access to the people who built it. Leave knowing more than you came with.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Gallery -->
	<section class="gallery-section">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow">The Property</span>
				<h2>750 square feet of intention. 1,280 of open air.</h2>
			</div>
			<div class="photo-grid">
				<figure class="photo photo-feature"><img src="/images/IMG_20251126_142830.jpg" alt="Sustainabox property in the Texas Hill Country" loading="lazy" /></figure>
				<figure class="photo photo-wide"><img src="/images/deck%202.jpeg" alt="Outdoor deck and living space" loading="lazy" /></figure>
				<figure class="photo"><img src="/images/Interior-1.jpg" alt="Main living interior" loading="lazy" /></figure>
				<figure class="photo"><img src="/images/Interior-Kitchen-Container-1.jpg" alt="Kitchen container" loading="lazy" /></figure>
				<figure class="photo"><img src="/images/Interior-Bedroom-Container-1.jpg" alt="Bedroom container" loading="lazy" /></figure>
				<figure class="photo"><img src="/images/20ft%20interior%20wood.jpeg" alt="20-foot container interior, wood finishes" loading="lazy" /></figure>
				<figure class="photo photo-wide"><img src="/images/deck.jpeg" alt="Deck and Hill Country views" loading="lazy" /></figure>
			</div>
		</div>
	</section>

	<!-- Stats Band -->
	<section class="stats-band">
		<div class="container">
			<div class="stats-row">
				<div class="stat-block">
					<span class="stat-num">3</span>
					<span class="stat-cap">Shipping Containers</span>
				</div>
				<div class="stat-block">
					<span class="stat-num">750</span>
					<span class="stat-cap">Sq Ft Interior</span>
				</div>
				<div class="stat-block">
					<span class="stat-num">1,280</span>
					<span class="stat-cap">Sq Ft of Deck</span>
				</div>
				<div class="stat-block">
					<span class="stat-num">7</span>
					<span class="stat-cap">Years Homebuilding</span>
				</div>
			</div>
		</div>
	</section>

	<!-- Design Principles -->
	<section class="design-principles-section">
		<div class="container">
			<div class="principles-layout">
				<div class="principles-image">
					<img src="/images/Interior-3.jpg" alt="Sustainabox interior — purposeful, efficient design" />
				</div>
				<div class="principles-text">
					<span class="eyebrow">How It's Built</span>
					<h2>Design Principles</h2>
					<p class="principles-intro">Every system reflects our approach to resilience, sustainability, and intentional living.</p>

					<div class="principle-item">
						<h3>Tiny</h3>
						<p>Efficient, purposeful living. No wasted space. Maximum comfort in minimal footprint.</p>
					</div>
					<div class="principle-item">
						<h3>Sustainable</h3>
						<p>Grid-connected with resilience principles built in. Designed for durability and adaptability.</p>
					</div>
					<div class="principle-item">
						<h3>Simple</h3>
						<p>Straightforward systems. No unnecessary complexity. Easy to maintain and understand.</p>
					</div>
					<div class="principle-item">
						<h3>Mobile</h3>
						<p>The 20-foot container sits on a trailer. Built for flexibility, travel, and exploration.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Beyond the Stay -->
	<section class="beyond-section">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow">Beyond the Stay</span>
				<h2>Planning a build of your own?</h2>
				<p>The stay is just the start. Go deeper whenever you're ready.</p>
			</div>
			<div class="beyond-links">
				<a href="/course" class="beyond-link">
					<h3>Learn the Build</h3>
					<p>The four-hour walkthrough, on demand. Foundation to finishes.</p>
					<span class="beyond-arrow">Explore the course →</span>
				</a>
				<a href="/construction" class="beyond-link">
					<h3>The Build, Documented</h3>
					<p>Drawings, systems, and decisions from start to finish.</p>
					<span class="beyond-arrow">See the build →</span>
				</a>
				<a href="/offerings" class="beyond-link">
					<h3>Work With Us</h3>
					<p>Templates, tools, and expert guidance for your own project.</p>
					<span class="beyond-arrow">View offerings →</span>
				</a>
			</div>
		</div>
	</section>

	<!-- Closing CTA -->
	<section class="closing-cta">
		<div class="cta-inner">
			<span class="eyebrow eyebrow-light">Your Weekend Awaits</span>
			<h2>Stay with us in the Hill Country.</h2>
			<p>Check dates, ask questions, and book your weekend at Sustainabox.</p>
			<a href="/book" class="btn btn-white">Book Your Stay</a>
		</div>
	</section>

</Layout>

<style>
	/* Hero Slider */
	.hero-slider-section {
		position: relative;
		height: 70vh;
		background: #1a2744;
	}

	.hero-slider {
		position: relative;
		height: 70vh;
		overflow: hidden;
	}

	.hero-slide {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		opacity: 0;
		transition: opacity 0.6s ease-in-out;
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 1;
	}

	.hero-slide.active {
		opacity: 1;
		z-index: 2;
	}

	.hero-overlay {
		background: linear-gradient(135deg, rgba(26,39,68,0.85), rgba(44,82,130,0.7));
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.hero-overlay-light {
		background: linear-gradient(135deg, rgba(247,243,239,0.95), rgba(235,244,255,0.95));
	}

	.hero-content {
		text-align: center;
		color: white;
		padding: 2rem;
		max-width: 700px;
	}

	.hero-overlay-light .hero-content {
		color: var(--color-navy);
	}

	.hero-eyebrow {
		display: inline-block;
		font-family: var(--font-body);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: rgba(255,255,255,0.85);
		margin-bottom: 1.25rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid rgba(255,255,255,0.4);
	}

	.hero-slide h1 {
		font-size: 3.5rem;
		font-weight: 700;
		margin-bottom: 1rem;
		line-height: 1.1;
		color: white;
	}

	.hero-overlay-light .hero-slide h1 {
		color: var(--color-navy);
	}

	.hero-tagline {
		font-family: var(--font-heading);
		font-size: 1.3rem;
		font-weight: 400;
		opacity: 0.95;
		margin-bottom: 1rem;
		font-style: italic;
		color: white;
	}

	.hero-overlay-light .hero-tagline {
		color: var(--color-blue);
		opacity: 0.9;
	}

	.hero-overlay-light .hero-sub {
		color: var(--color-navy);
	}

	.hero-overlay-light .btn {
		background: var(--color-blue);
		color: white;
	}

	.hero-overlay-light .btn:hover {
		background: var(--color-navy);
	}

	.hero-sub {
		font-size: 1.1rem;
		line-height: 1.8;
		opacity: 0.9;
		margin-bottom: 2rem;
		color: white;
	}

	.hero-overlay-light .hero-sub {
		color: var(--color-text);
	}

	/* Hero Slider Navigation */
	.hero-slider-btn {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		background: rgba(255,255,255,0.3);
		color: white;
		border: none;
		font-size: 2rem;
		padding: 1rem;
		cursor: pointer;
		z-index: 10;
		transition: background 0.3s;
	}

	.hero-slider-btn:hover {
		background: rgba(255,255,255,0.5);
	}

	.hero-slider-prev {
		left: 2rem;
	}

	.hero-slider-next {
		right: 2rem;
	}

	/* Hero Slider Indicators */
	.hero-slider-indicators {
		position: absolute;
		bottom: 2rem;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		gap: 0.75rem;
		z-index: 10;
	}

	.hero-indicator {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: rgba(255,255,255,0.5);
		border: none;
		cursor: pointer;
		transition: background 0.3s;
	}

	.hero-indicator.active {
		background: white;
	}

	.hero-indicator:hover {
		background: rgba(255,255,255,0.8);
	}

	/* Pause Button */
	.hero-slider-pause {
		position: absolute;
		bottom: 2rem;
		right: 2rem;
		padding: 0.6rem 1rem;
		background: rgba(255,255,255,0.3);
		color: white;
		border: 1px solid rgba(255,255,255,0.5);
		border-radius: 4px;
		cursor: pointer;
		font-size: 1rem;
		transition: all 0.3s;
		z-index: 10;
	}

	.hero-slider-pause:hover {
		background: rgba(255,255,255,0.5);
	}

	.hero-slider-pause.paused {
		background: rgba(255,255,255,0.5);
		border-color: rgba(255,255,255,0.8);
	}

	/* Design Principles Section */
	.design-principles-section {
		padding: 5rem 0;
		background: white;
	}

	.design-principles-section h2 {
		text-align: center;
		margin-bottom: 1rem;
	}

	.design-principles-section > .container > p {
		text-align: center;
		color: var(--color-muted);
		margin-bottom: 3rem;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
	}

	.principles-layout {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		align-items: center;
	}

	.principles-image img {
		width: 100%;
		height: 100%;
		max-height: 520px;
		object-fit: cover;
		border-radius: 4px;
	}

	.principles-text h2 {
		text-align: left;
		margin-bottom: 0.75rem;
	}

	.principles-intro {
		text-align: left !important;
		margin: 0 0 2rem 0 !important;
		max-width: none !important;
	}

	.principle-item {
		padding: 1rem 0;
		border-bottom: 1px solid #e2e8f0;
	}

	.principle-item:last-child {
		border-bottom: none;
	}

	.principle-item h3 {
		color: var(--color-navy);
		margin-bottom: 0.4rem;
		font-size: 1.1rem;
		font-weight: 600;
	}

	.principle-item p {
		color: var(--color-muted);
		font-size: 0.95rem;
		line-height: 1.6;
		margin: 0;
	}

	/* Progress Section */
	.progress-section {
		padding: 5rem 0;
		background: var(--color-warm);
	}

	.progress-section h2 {
		text-align: center;
		margin-bottom: 1rem;
	}

	.progress-section > .container > p {
		text-align: center;
		color: var(--color-muted);
		margin-bottom: 2rem;
	}

	.progress-gallery {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
		margin-top: 2rem;
	}

	.progress-gallery img {
		width: 100%;
		height: 300px;
		object-fit: cover;
		border-radius: 4px;
		display: block;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
		transition: transform 0.3s ease;
	}

	.progress-gallery img:hover {
		transform: scale(1.05);
	}

	.gallery-placeholder {
		color: var(--color-muted);
		font-size: 1.1rem;
	}

	/* Offerings Section */
	.offerings-section {
		padding: 5rem 0;
		background: white;
	}

	.offerings-section h2 {
		text-align: center;
		margin-bottom: 1.5rem;
	}

	.offerings-section > .container > p {
		text-align: center;
		font-size: 1.1rem;
		margin-bottom: 3rem;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
	}

	.offerings-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 3rem 2rem;
	}

	.offering-card {
		background: white;
		padding: 2rem;
		border-radius: 0px;
		border: none;
		border-left: 3px solid var(--color-blue);
		display: flex;
		flex-direction: column;
		transition: none;
		box-shadow: none;
		position: relative;
	}

	.offering-card:hover {
		transform: none;
		box-shadow: none;
		border-left-color: var(--color-navy);
	}

	.offering-icon {
		display: none;
	}

	.offering-card h3 {
		color: var(--color-navy);
		margin-bottom: 0.75rem;
		font-size: 1.15rem;
		font-weight: 600;
		letter-spacing: 0.3px;
	}

	.offering-card p {
		font-size: 0.9rem;
		color: var(--color-muted);
		margin-bottom: 1.5rem;
		flex-grow: 1;
		line-height: 1.6;
	}

	.offering-card .btn {
		align-self: flex-start;
		margin-top: auto;
		font-size: 0.85rem;
	}

	/* Carousel/Slider */
	.slider-section {
		padding: 5rem 0;
		background: white;
	}

	.slider-section h2 {
		text-align: center;
		margin-bottom: 1rem;
	}

	.slider-section > .container > p {
		text-align: center;
		color: var(--color-muted);
		margin-bottom: 3rem;
	}

	.carousel-wrapper {
		position: relative;
		background: var(--color-warm);
		border-radius: 6px;
		overflow: hidden;
		padding: 3rem 2rem;
	}

	.carousel {
		display: flex;
		transition: transform 0.5s ease;
	}

	.carousel-slide {
		min-width: 100%;
		display: flex;
		flex-direction: column;
		padding-right: 2rem;
	}

	.slide-header {
		text-align: center;
		margin-bottom: 2rem;
	}

	.slide-header h3 {
		color: var(--color-blue);
		margin-bottom: 0.5rem;
	}

	.slide-header p {
		color: var(--color-muted);
		max-width: 500px;
		margin: 0 auto;
	}

	.slide-gallery {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
		max-height: 600px;
		overflow: hidden;
	}

	.slide-gallery img {
		width: 100%;
		height: 280px;
		object-fit: cover;
		border-radius: 4px;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
		transition: transform 0.3s ease;
	}

	.slide-gallery img:hover {
		transform: scale(1.05);
	}

	.carousel-btn {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		background: var(--color-blue);
		color: white;
		border: none;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		font-size: 1.2rem;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: background 0.3s;
		z-index: 10;
	}

	.carousel-btn:hover {
		background: var(--color-navy);
	}

	.carousel-prev {
		left: 1rem;
	}

	.carousel-next {
		right: 1rem;
	}

	.carousel-indicators {
		display: flex;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.indicator {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		border: 2px solid var(--color-blue);
		background: transparent;
		cursor: pointer;
		transition: all 0.3s;
	}

	.indicator.active {
		background: var(--color-blue);
	}

	.indicator:hover {
		background: var(--color-blue);
	}

	/* Shared editorial elements */
	.eyebrow {
		display: inline-block;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-blue);
		margin-bottom: 1rem;
	}

	.section-head {
		max-width: 720px;
		margin: 0 auto 3.5rem;
		text-align: center;
	}

	.section-head h2 {
		font-size: 2.3rem;
		line-height: 1.15;
	}

	.section-head p {
		color: var(--color-muted);
		font-size: 1.1rem;
		margin: 1rem auto 0;
		max-width: 560px;
	}

	/* Story Section */
	.story-section {
		padding: 6rem 0;
		background: white;
	}

	.story-layout {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4.5rem;
		align-items: center;
	}

	.story-text h2 {
		font-size: 2.4rem;
		line-height: 1.15;
