---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sustainabox — Resilience Designed. Built Real.">

	<!-- Hero -->
	<header class="hero">
		<div class="hero-overlay">
			<div class="hero-content">
				<h1>Build Resilient Housing</h1>
				<p class="hero-tagline">Resilience Designed. Built Real.</p>
				<p class="hero-sub">Expert guidance for designing, planning, and executing container homes and alternative housing projects that survive chaos and scale impact.</p>
				<div class="hero-ctas">
					<a href="/consulting" class="btn btn-primary">Get Consulting</a>
					<a href="/course" class="btn btn-outline">Learn the Course</a>
				</div>
			</div>
		</div>
	</header>

	<!-- Why Sustainabox -->
	<section class="why-section">
		<div class="container">
			<h2>Why Sustainabox</h2>
			<p>We combine enterprise-grade risk thinking with hands-on construction expertise to help you design, plan, and execute alternative housing projects with clarity and confidence.</p>

			<div class="pillars">
				<div class="pillar">
					<h3>Authentic</h3>
					<p>Built and lived through a real container home project. Not theory. Real costs, real mistakes, real solutions.</p>
				</div>
				<div class="pillar">
					<h3>Practical</h3>
					<p>Grounded in permits, trades, budgets, timelines, and trade-offs. No fluff. Framework applies to 1 home or 100 units.</p>
				</div>
				<div class="pillar">
					<h3>Expert-Led</h3>
					<p>Founder has 15+ years in enterprise resilience, risk management, and technology. Applied to housing design and execution.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- What We Offer -->
	<section class="services-section">
		<div class="container">
			<h2>What We Offer</h2>

			<div class="services-grid">
				<!-- Consulting -->
				<div class="service-card">
					<div class="service-icon">📋</div>
					<h3>Consulting</h3>
					<p>Design review, feasibility studies, cost optimization, timeline planning, and risk mitigation for your project.</p>
					<ul class="service-details">
						<li>Design review: $500–2K</li>
						<li>Full planning: $3K–10K</li>
						<li>Fractional architect: $150–250/hr</li>
					</ul>
					<a href="/consulting" class="btn btn-outline">Learn More</a>
				</div>

				<!-- Course -->
				<div class="service-card">
					<div class="service-icon">🎓</div>
					<h3>Cohort Course</h3>
					<p>Learn the full design-to-build process from someone who's built one. Live expert calls, templates, community access.</p>
					<ul class="service-details">
						<li>8 weeks, cohort-based</li>
						<li>Monthly cohorts</li>
						<li>$750–1,200 per cohort</li>
					</ul>
					<a href="/course" class="btn btn-outline">Enroll</a>
				</div>

				<!-- Products -->
				<div class="service-card">
					<div class="service-icon">📦</div>
					<h3>Digital Products</h3>
					<p>Cost calculator, project planner, design checklists, and decision frameworks. Use independently or with the course.</p>
					<ul class="service-details">
						<li>Cost Calculator: $29</li>
						<li>Project Planner: $39</li>
						<li>All three: $79</li>
					</ul>
					<a href="/products" class="btn btn-outline">Browse</a>
				</div>

				<!-- Community -->
				<div class="service-card">
					<div class="service-icon">🤝</div>
					<h3>Membership</h3>
					<p>Join a network of builders, designers, and entrepreneurs. Expert calls, peer feedback, exclusive templates, community forum.</p>
					<ul class="service-details">
						<li>$30/month or $300/year</li>
						<li>Expert office hours</li>
						<li>Member-only resources</li>
					</ul>
					<a href="/community" class="btn btn-outline">Join</a>
				</div>
			</div>
		</div>
	</section>

	<!-- The Project (Trust Signal) -->
	<section class="project-section">
		<div class="container">
			<h2>The Project</h2>
			<p>Sustainabox is a real container home built near Austin, Texas. Three shipping containers, pier foundations, full systems. Completed. Lessons documented.</p>

			<div class="project-grid">
				<div class="project-stat">
					<div class="stat-number">3</div>
					<div class="stat-label">Containers</div>
				</div>
				<div class="project-stat">
					<div class="stat-number">2,400</div>
					<div class="stat-label">Sq Ft</div>
				</div>
				<div class="project-stat">
					<div class="stat-number">18</div>
					<div class="stat-label">Months</div>
				</div>
				<div class="project-stat">
					<div class="stat-number">100+</div>
					<div class="stat-label">Documented Lessons</div>
				</div>
			</div>

			<p style="margin-top: 2rem; text-align: center;">
				<a href="/vision" class="btn btn-outline">See Full Case Study</a>
			</p>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="cta-section">
		<div class="container">
			<h2>Ready to Build?</h2>
			<p>Start with a free consultation call, explore our products, or join the community.</p>
			<div class="cta-buttons">
				<a href="/contact" class="btn btn-primary">Schedule a Call</a>
				<a href="/products" class="btn btn-outline">Browse Products</a>
				<a href="/community" class="btn btn-outline">Join Community</a>
			</div>
		</div>
	</section>

</Layout>

<style>
	/* Hero */
	.hero {
		background: url('/images/Elevation-2-2.jpg') center/cover no-repeat;
		min-height: 70vh;
		position: relative;
	}

	.hero-overlay {
		background: linear-gradient(135deg, rgba(26,39,68,0.85), rgba(44,82,130,0.7));
		min-height: 70vh;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.hero-content {
		text-align: center;
		color: white;
		padding: 2rem;
		max-width: 700px;
	}

	.hero h1 {
		font-size: 3.5rem;
		font-weight: 700;
		margin-bottom: 0.25rem;
		line-height: 1.1;
	}

	.hero-tagline {
		font-family: var(--font-heading);
		font-size: 1.3rem;
		font-weight: 400;
		opacity: 0.95;
		margin-bottom: 1rem;
		font-style: italic;
	}

	.hero-sub {
		font-size: 1.1rem;
		line-height: 1.8;
		opacity: 0.9;
		margin-bottom: 2rem;
	}

	.hero-ctas {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	/* Why Section */
	.why-section {
		padding: 5rem 0;
		background: var(--color-warm);
	}

	.why-section h2 {
		text-align: center;
		margin-bottom: 1.5rem;
	}

	.why-section > .container > p {
		text-align: center;
		font-size: 1.1rem;
		margin-bottom: 3rem;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
	}

	.pillars {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 2rem;
	}

	.pillar {
		background: white;
		padding: 2rem;
		border-radius: 8px;
		box-shadow: 0 2px 8px rgba(0,0,0,0.05);
	}

	.pillar h3 {
		color: var(--color-blue);
		margin-bottom: 0.75rem;
	}

	.pillar p {
		font-size: 0.95rem;
		color: var(--color-muted);
		line-height: 1.6;
	}

	/* Services Section */
	.services-section {
		padding: 5rem 0;
	}

	.services-section h2 {
		text-align: center;
		margin-bottom: 3rem;
	}

	.services-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 2rem;
	}

	.service-card {
		background: var(--color-warm);
		border-radius: 12px;
		padding: 2rem;
		border-left: 4px solid var(--color-blue);
		display: flex;
		flex-direction: column;
	}

	.service-icon {
		font-size: 2.5rem;
		margin-bottom: 1rem;
	}

	.service-card h3 {
		margin-bottom: 0.75rem;
		color: var(--color-navy);
	}

	.service-card p {
		font-size: 0.95rem;
		margin-bottom: 1.25rem;
		flex-grow: 1;
	}

	.service-details {
		list-style: none;
		padding: 0;
		margin-bottom: 1.5rem;
		font-size: 0.9rem;
		color: var(--color-muted);
	}

	.service-details li {
		padding: 0.4rem 0;
	}

	.service-details li::before {
		content: "✓ ";
		color: var(--color-blue);
		font-weight: 600;
		margin-right: 0.5rem;
	}

	.service-card .btn {
		align-self: flex-start;
	}

	/* Project Section */
	.project-section {
		padding: 5rem 0;
		background: white;
	}

	.project-section h2 {
		text-align: center;
		margin-bottom: 1rem;
	}

	.project-section > .container > p:first-of-type {
		text-align: center;
		font-size: 1.05rem;
		margin-bottom: 3rem;
		color: var(--color-muted);
	}

	.project-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		gap: 2rem;
		margin-bottom: 2rem;
	}

	.project-stat {
		text-align: center;
		padding: 2rem;
		background: var(--color-warm);
		border-radius: 8px;
	}

	.stat-number {
		font-size: 2.5rem;
		font-weight: 700;
		color: var(--color-blue);
		margin-bottom: 0.5rem;
	}

	.stat-label {
		font-size: 0.9rem;
		color: var(--color-muted);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	/* CTA Section */
	.cta-section {
		padding: 5rem 0;
		background: var(--color-navy);
		color: white;
		text-align: center;
	}

	.cta-section h2 {
		color: white;
		margin-bottom: 1rem;
	}

	.cta-section p {
		font-size: 1.1rem;
		margin-bottom: 2rem;
		opacity: 0.9;
	}

	.cta-buttons {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.cta-section .btn-primary {
		background: white;
		color: var(--color-navy);
	}

	.cta-section .btn-primary:hover {
		background: var(--color-sky);
	}

	.cta-section .btn-outline {
		border-color: white;
		color: white;
	}

	.cta-section .btn-outline:hover {
		background: white;
		color: var(--color-navy);
	}

	/* Mobile */
	@media (max-width: 768px) {
		.hero h1 {
			font-size: 2.2rem;
		}

		.hero-tagline {
			font-size: 1rem;
		}

		.hero-ctas {
			flex-direction: column;
		}

		.hero-ctas .btn {
			width: 100%;
		}
	}
</style>
