<script>
	document.addEventListener('DOMContentLoaded', () => {
		// Hero Slider
		const heroSlides = document.querySelectorAll('.hero-slide');
		const heroIndicators = document.querySelectorAll('.hero-indicator');
		const heroPrevBtn = document.querySelector('.hero-slider-prev');
		const heroNextBtn = document.querySelector('.hero-slider-next');
		const heroPauseBtn = document.querySelector('.hero-slider-pause');

		let currentHeroSlide = 0;
		let isPlaying = true;
		let autoAdvanceInterval;

		function showHeroSlide(n) {
			heroSlides.forEach(slide => slide.classList.remove('active'));
			heroIndicators.forEach(indicator => indicator.classList.remove('active'));
			heroSlides[n].classList.add('active');
			heroIndicators[n].classList.add('active');
			currentHeroSlide = n;
		}

		function nextHeroSlide() {
			const next = (currentHeroSlide + 1) % heroSlides.length;
			showHeroSlide(next);
		}

		function prevHeroSlide() {
			const prev = (currentHeroSlide - 1 + heroSlides.length) % heroSlides.length;
			showHeroSlide(prev);
		}

		function startAutoAdvance() {
			isPlaying = true;
			heroPauseBtn.classList.remove('paused');
			heroPauseBtn.textContent = '⏸';
			autoAdvanceInterval = setInterval(nextHeroSlide, 10000);
		}

		function stopAutoAdvance() {
			isPlaying = false;
			heroPauseBtn.classList.add('paused');
			heroPauseBtn.textContent = '▶';
			clearInterval(autoAdvanceInterval);
		}

		function togglePause() {
			if (isPlaying) {
				stopAutoAdvance();
			} else {
				startAutoAdvance();
			}
		}

		if (heroPrevBtn && heroNextBtn) {
			heroPrevBtn.addEventListener('click', prevHeroSlide);
			heroNextBtn.addEventListener('click', nextHeroSlide);
		}

		if (heroPauseBtn) {
			heroPauseBtn.addEventListener('click', togglePause);
		}

		heroIndicators.forEach((indicator, index) => {
			indicator.addEventListener('click', () => showHeroSlide(index));
		});

		// Auto-advance hero slides every 10 seconds
		startAutoAdvance();
	});
</script>
