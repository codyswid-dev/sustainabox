---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sustainabox — Resilience Designed. Built Real.">

	<!-- Hero -->
	<header class="hero">
		<div class="hero-overlay">
			<div class="hero-content">
				<h1>Sustainabox</h1>
				<p class="hero-tagline">Resilience Designed. Built Real.</p>
				<p class="hero-sub">Tiny. Sustainable. Simple. Built for life, travel, and resilience.</p>
			</div>
		</div>
	</header>

	<!-- Philosophy -->
	<section class="philosophy-section">
		<div class="container">
			<h2>Our Philosophy</h2>
			<p>Sustainabox is more than a home. It's a commitment to living intentionally.</p>

			<div class="philosophy-grid">
				<div class="philosophy-card">
					<div class="philosophy-icon">🏠</div>
					<h3>Tiny</h3>
					<p>Efficient, purposeful living. No wasted space. Everything has a reason. Maximum comfort in minimal footprint.</p>
				</div>
				<div class="philosophy-card">
					<div class="philosophy-icon">🌱</div>
					<h3>Sustainable</h3>
					<p>Built to last. Off-grid capable. Low impact on the environment. Designed for resilience in an uncertain world.</p>
				</div>
				<div class="philosophy-card">
					<div class="philosophy-icon">⚙️</div>
					<h3>Simple</h3>
					<p>Straightforward systems. No unnecessary complexity. Easy to maintain, repair, and understand. Elegant in its simplicity.</p>
				</div>
				<div class="philosophy-card">
					<div class="philosophy-icon">🌍</div>
					<h3>Travel365</h3>
					<p>Mobile by design. Your home goes where you go. Built for adventure, travel, and exploration without leaving home behind.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Build Process -->
	<section class="progress-section">
		<div class="container">
			<h2>The Build</h2>
			<p>From design to delivery to foundation. Here's how it started.</p>

			<div class="progress-gallery">
				<img src="/images/Elevation 1.jpg" alt="Final design elevation" loading="lazy" />
				<img src="/images/crane over lake.jpg" alt="Crane delivery over water" loading="lazy" />
				<img src="/images/crane.jpg" alt="Crane placement on site" loading="lazy" />
				<img src="/images/foundation.jpg" alt="Pier foundation detail" loading="lazy" />
			</div>
		</div>
	</section>

	<!-- Structural & Systems -->
	<section class="progress-section">
		<div class="container">
			<h2>Structural & Systems</h2>
			<p>Framing, welding, insulation, and MEP rough-in. Building it solid.</p>

			<div class="progress-gallery">
				<img src="/images/window framing and cutting.jpg" alt="Window framing and cutting work" loading="lazy" />
				<img src="/images/windows and doors welding.jpg" alt="Welding windows and doors" loading="lazy" />
				<img src="/images/interior metal framing.jpeg" alt="Interior metal framing" loading="lazy" />
				<img src="/images/steel reinforcements.jpg" alt="Steel reinforcements" loading="lazy" />
				<img src="/images/spray foam.jpeg" alt="Spray foam insulation" loading="lazy" />
				<img src="/images/window fitting.jpg" alt="Window fitting installation" loading="lazy" />
				<img src="/images/window insulation.jpeg" alt="Window insulation detail" loading="lazy" />
				<img src="/images/20 ft window cut.jpg" alt="20ft container window cut" loading="lazy" />
			</div>
		</div>
	</section>

	<!-- Interiors & Finishes -->
	<section class="progress-section">
		<div class="container">
			<h2>Interiors & Finishes</h2>
			<p>Kitchen, bath, flooring, and details. The space where living happens.</p>

			<div class="progress-gallery">
				<img src="/images/20ft interior wood.jpeg" alt="20ft interior wood detail" loading="lazy" />
				<img src="/images/20ft interior wood2.jpeg" alt="20ft interior wood finish" loading="lazy" />
				<img src="/images/flooring.jpeg" alt="Flooring installation" loading="lazy" />
				<img src="/images/kitchen countertop.jpeg" alt="Kitchen countertop" loading="lazy" />
				<img src="/images/kitchen cabinets.jpeg" alt="Kitchen cabinets" loading="lazy" />
				<img src="/images/kitchen bathroom.jpeg" alt="Kitchen and bathroom layout" loading="lazy" />
				<img src="/images/shower.jpeg" alt="Shower installation" loading="lazy" />
			</div>
		</div>
	</section>

	<!-- Exteriors & Outdoor -->
	<section class="progress-section">
		<div class="container">
			<h2>Exteriors & Outdoor</h2>
			<p>Deck, landscape, and outdoor living spaces.</p>

			<div class="progress-gallery">
				<img src="/images/deck.jpeg" alt="Deck construction" loading="lazy" />
				<img src="/images/deck 2.jpeg" alt="Deck detail" loading="lazy" />
				<img src="/images/car port.jpeg" alt="Carport detail" loading="lazy" />
			</div>
		</div>
	</section>

	<!-- What We Offer -->
	<section class="offerings-section">
		<div class="container">
			<h2>What We Offer</h2>
			<p>Whether you want to build, learn, stay, or connect — we have options for you.</p>

			<div class="offerings-grid">
				<!-- Consulting -->
				<div class="offering-card">
					<div class="offering-icon">🎯</div>
					<h3>Consulting</h3>
					<p>Expert guidance for designing and planning your container home or alternative housing project. Design review, cost optimization, timeline planning, and risk mitigation.</p>
					<a href="/consulting" class="btn btn-outline">Learn More</a>
				</div>

				<!-- Course -->
				<div class="offering-card">
					<div class="offering-icon">🎓</div>
					<h3>Learn</h3>
					<p>8-week cohort course. "Designing Your Resilient Home." Learn the full design-to-build process from someone who's actually built it.</p>
					<a href="/course" class="btn btn-outline">Explore Course</a>
				</div>

				<!-- Products -->
				<div class="offering-card">
					<div class="offering-icon">📦</div>
					<h3>Templates & Tools</h3>
					<p>Digital products to help you design and plan. Cost calculator, project planner, design checklists, and decision frameworks.</p>
					<a href="/products" class="btn btn-outline">Browse Tools</a>
				</div>

				<!-- Community -->
				<div class="offering-card">
					<div class="offering-icon">🤝</div>
					<h3>Community</h3>
					<p>Join a network of builders, designers, and entrepreneurs. Expert office hours, member resources, and peer support.</p>
					<a href="/community" class="btn btn-outline">Join Us</a>
				</div>

				<!-- Experiences -->
				<div class="offering-card">
					<div class="offering-icon">🏡</div>
					<h3>Experiences</h3>
					<p>Stay at the property. Learn by doing. Design workshops, retreats, and hands-on experiences at our completed compound.</p>
					<a href="#contact" class="btn btn-outline">Book Experience</a>
				</div>

				<!-- The Build -->
				<div class="offering-card">
					<div class="offering-icon">📚</div>
					<h3>The Build</h3>
					<p>Complete documentation of our container home build. Drawings, systems, specifications, and technical details from start to finish.</p>
					<a href="/construction" class="btn btn-outline">See Details</a>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="cta-section" id="contact">
		<div class="container">
			<h2>What's Your Next Move?</h2>
			<p>Ready to explore sustainable living? Reach out and let's talk.</p>
			<div class="cta-buttons">
				<a href="/consulting" class="btn btn-primary">Schedule Consulting</a>
				<a href="/contact" class="btn btn-outline">Get in Touch</a>
			</div>
		</div>
	</section>

</Layout>

<style>
	/* Hero */
	.hero {
		background: url('/images/PXL_20260513_152354256~2.jpg.jpeg') center/cover no-repeat;
		min-height: 70vh;
		position: relative;
	}

	.hero-overlay {
		background: linear-gradient(135deg, rgba(26,39,68,0.85), rgba(44,82,130,0.7));
		min-height: 70vh;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.hero-content {
		text-align: center;
		color: white;
		padding: 2rem;
		max-width: 700px;
	}

	.hero h1 {
		font-size: 3.5rem;
		font-weight: 700;
		margin-bottom: 0.25rem;
		line-height: 1.1;
		color: white;
	}

	.hero-tagline {
		font-family: var(--font-heading);
		font-size: 1.3rem;
		font-weight: 400;
		opacity: 0.95;
		margin-bottom: 1rem;
		font-style: italic;
		color: white;
	}

	.hero-sub {
		font-size: 1.1rem;
		line-height: 1.8;
		opacity: 0.9;
		margin-bottom: 2rem;
		color: white;
	}

	/* Philosophy Section */
	.philosophy-section {
		padding: 5rem 0;
		background: white;
	}

	.philosophy-section h2 {
		text-align: center;
		margin-bottom: 1.5rem;
	}

	.philosophy-section > .container > p {
		text-align: center;
		font-size: 1.1rem;
		margin-bottom: 3rem;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
	}

	.philosophy-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 2rem;
	}

	.philosophy-card {
		background: var(--color-warm);
		padding: 2rem;
		border-radius: 8px;
		text-align: center;
		border-top: 3px solid var(--color-blue);
	}

	.philosophy-icon {
		font-size: 2.5rem;
		margin-bottom: 1rem;
	}

	.philosophy-card h3 {
		color: var(--color-blue);
		margin-bottom: 0.75rem;
	}

	.philosophy-card p {
		font-size: 0.95rem;
		color: var(--color-muted);
		line-height: 1.6;
	}

	/* Progress Section */
	.progress-section {
		padding: 5rem 0;
		background: var(--color-warm);
	}

	.progress-section h2 {
		text-align: center;
		margin-bottom: 1rem;
	}

	.progress-section > .container > p {
		text-align: center;
		color: var(--color-muted);
		margin-bottom: 2rem;
	}

	.progress-gallery {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
		margin-top: 2rem;
	}

	.progress-gallery img {
		width: 100%;
		height: 300px;
		object-fit: cover;
		border-radius: 8px;
		display: block;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
		transition: transform 0.3s ease;
	}

	.progress-gallery img:hover {
		transform: scale(1.05);
	}

	.gallery-placeholder {
		color: var(--color-muted);
		font-size: 1.1rem;
	}

	/* Offerings Section */
	.offerings-section {
		padding: 5rem 0;
		background: white;
	}

	.offerings-section h2 {
		text-align: center;
		margin-bottom: 1.5rem;
	}

	.offerings-section > .container > p {
		text-align: center;
		font-size: 1.1rem;
		margin-bottom: 3rem;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
	}

	.offerings-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 2rem;
	}

	.offering-card {
		background: var(--color-warm);
		padding: 2rem;
		border-radius: 8px;
		border-left: 4px solid var(--color-blue);
		display: flex;
		flex-direction: column;
	}

	.offering-icon {
		font-size: 2rem;
		margin-bottom: 1rem;
	}

	.offering-card h3 {
		color: var(--color-blue);
		margin-bottom: 0.75rem;
	}

	.offering-card p {
		font-size: 0.95rem;
		color: var(--color-muted);
		margin-bottom: 1.5rem;
		flex-grow: 1;
	}

	.offering-card .btn {
		align-self: flex-start;
	}

	/* CTA Section */
	.cta-section {
		padding: 5rem 0;
		background: var(--color-navy);
		color: white;
		text-align: center;
	}

	.cta-section h2 {
		color: white;
		margin-bottom: 1rem;
	}

	.cta-section p {
		font-size: 1.1rem;
		margin-bottom: 2rem;
		opacity: 0.9;
	}

	.cta-buttons {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.cta-section .btn-primary {
		background: white;
		color: var(--color-navy);
	}

	.cta-section .btn-primary:hover {
		background: var(--color-sky);
	}

	/* Mobile */
	@media (max-width: 768px) {
		.hero h1 {
			font-size: 2.2rem;
		}

		.hero-tagline {
			font-size: 1rem;
		}

		.philosophy-grid {
			grid-template-columns: 1fr;
		}

		.offerings-grid {
			grid-template-columns: 1fr;
		}

		.cta-buttons {
			flex-direction: column;
		}

		.cta-buttons .btn {
			width: 100%;
		}
	}
</style>
