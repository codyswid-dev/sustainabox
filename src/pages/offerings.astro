---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Offerings — Sustainabox">

	<div class="page-header">
		<div class="container">
			<h1>Everything We Offer</h1>
			<p>Expert consulting, educational content, and digital tools to help you design, build, and learn.</p>
		</div>
	</div>

	<section class="container content-section">
		<!-- WHY WORK WITH US -->
		<div class="offering-section">
			<h2>Why Work With Us?</h2>
			<div class="why-consulting">
				<div class="why-grid">
					<div class="why-item">
						<h4>Real Experience</h4>
						<p>We've designed and built a full container home. We know costs, timelines, mistakes, and trade-offs firsthand.</p>
					</div>
					<div class="why-item">
						<h4>Risk Thinking</h4>
						<p>15+ years of enterprise risk and resilience expertise. We identify risks others miss.</p>
					</div>
					<div class="why-item">
						<h4>Vendor Network</h4>
						<p>We know contractors, material suppliers, permitting officials, and inspectors. We help you avoid bad decisions.</p>
					</div>
					<div class="why-item">
						<h4>Practical, Not Theoretical</h4>
						<p>Advice grounded in actual constraints: budgets, timelines, local codes, trade availability. No fluff.</p>
					</div>
				</div>
			</div>
		</div>

		<!-- PRODUCTS -->
		<div class="offering-section">
			<h2>Digital Templates & Tools</h2>
			<p>Ready-made templates to help you design, plan, and execute your project independently or alongside the course.</p>

			<div class="products-grid">
				<div class="product-card">
					<h3>Cost Calculator</h3>
					<p class="price">$29</p>
					<p>Detailed cost breakdown for container homes and alternative housing.</p>
					<ul>
						<li>Materials breakdown by category</li>
						<li>Labor estimates by trade</li>
						<li>Contingency planning (20–30%)</li>
						<li>Real data from our build</li>
					</ul>
					<a href="https://gumroad.com/l/sustainabox-cost-calculator" class="btn btn-outline" target="_blank">Buy Now</a>
				</div>

				<div class="product-card">
					<h3>Project Planner</h3>
					<p class="price">$39</p>
					<p>Timeline and milestone tracker from design through handoff.</p>
					<ul>
						<li>Phase breakdown (design, permits, build, finishes)</li>
						<li>Realistic durations and dependencies</li>
						<li>Milestone checklist</li>
						<li>Trade coordination notes</li>
					</ul>
					<a href="https://gumroad.com/l/sustainabox-project-planner" class="btn btn-outline" target="_blank">Buy Now</a>
				</div>

				<div class="product-card">
					<h3>Design Checklist</h3>
					<p class="price">$19</p>
					<p>Comprehensive design and code compliance checklist.</p>
					<ul>
						<li>Site analysis questions</li>
						<li>Code compliance by jurisdiction</li>
						<li>Safety and accessibility checks</li>
						<li>Systems coordination</li>
					</ul>
					<a href="https://gumroad.com/l/sustainabox-design-checklist" class="btn btn-outline" target="_blank">Buy Now</a>
				</div>

				<div class="product-card bundle">
					<h3>Complete Bundle</h3>
					<p class="price">$79 <span class="savings">(Save $8)</span></p>
					<p>All three templates, ready to customize.</p>
					<ul>
						<li>Cost Calculator</li>
						<li>Project Planner</li>
						<li>Design Checklist</li>
						<li>Lifetime updates</li>
					</ul>
					<a href="https://gumroad.com/l/sustainabox-bundle" class="btn btn-primary" target="_blank">Buy Bundle</a>
				</div>
			</div>

			<p style="text-align: center; margin-top: 2rem; color: var(--color-muted);">All products are digital downloads delivered immediately after purchase.</p>
		</div>

		<!-- CONSULTING -->
		<div class="offering-section">
			<h2>Expert Consulting</h2>
			<p>Design review, planning, risk mitigation, and expert guidance for your container home or alternative housing project.</p>

			<div class="consulting-offerings">
				<div class="consulting-card">
					<h3>Design Review & Feasibility</h3>
					<p class="price">$500–2,000</p>
					<p>Send us your plans, photos, or ideas. We review for:</p>
					<ul>
						<li>Structural feasibility</li>
						<li>Code compliance risks</li>
						<li>Cost optimization opportunities</li>
						<li>Timeline risks</li>
						<li>Supply chain and trade coordination</li>
					</ul>
					<p class="deliverable"><strong>Deliverable:</strong> Written report with findings and recommendations (3–5 pages).</p>
					<a href="/contact" class="btn btn-outline">Learn More</a>
				</div>

				<div class="consulting-card">
					<h3>Full Planning Package</h3>
					<p class="price">$3,000–10,000</p>
					<p>End-to-end planning for your project:</p>
					<ul>
						<li>Design optimization (if needed)</li>
						<li>Detailed cost breakdown (materials, labor, contingency)</li>
						<li>Timeline with milestones and dependencies</li>
						<li>Risk register (what could go wrong, how to mitigate)</li>
						<li>Permitting and code compliance roadmap</li>
						<li>Vendor and trade coordination plan</li>
					</ul>
					<p class="deliverable"><strong>Deliverable:</strong> 20–30 page planning document + 2 follow-up calls.</p>
					<a href="/contact" class="btn btn-outline">Learn More</a>
				</div>

				<div class="consulting-card">
					<h3>Fractional Architect / PM</h3>
					<p class="price">$150–250/hour</p>
					<p>Ongoing support during your build:</p>
					<ul>
						<li>Design decisions and problem-solving</li>
						<li>Code compliance questions</li>
						<li>Cost overrun analysis and mitigation</li>
						<li>Timeline adjustments</li>
						<li>Trade coordination and conflict resolution</li>
					</ul>
					<p class="deliverable"><strong>Deliverable:</strong> Hourly or monthly retainer. You call when you need guidance.</p>
					<a href="/contact" class="btn btn-outline">Learn More</a>
				</div>
			</div>
		</div>

		<!-- LEARNING -->
		<div class="offering-section">
			<h2>The 4-Hour Walkthrough</h2>
			<p>A recorded tour of the complete build. From foundation to finishes. Learn what works, what we'd do differently, and why.</p>

			<div class="learning-overview">
				<div class="learning-section">
					<h3>What You'll Learn</h3>
					<div class="topics-grid">
						<div class="topic">
							<strong>🏗️ Foundation & Site</strong>
							<p>Pier foundation design, site preparation, why we chose this approach.</p>
						</div>
						<div class="topic">
							<strong>📦 Container Modification</strong>
							<p>Cutting openings, reinforcing structure, integrating MEP systems.</p>
						</div>
						<div class="topic">
							<strong>⚡ Electrical Systems</strong>
							<p>Main panel, circuits, load calculations, grounding, efficiency design.</p>
						</div>
						<div class="topic">
							<strong>💧 Plumbing & Water</strong>
							<p>Supply lines, fixtures, septic integration, water management.</p>
						</div>
						<div class="topic">
							<strong>🌡️ Thermal & HVAC</strong>
							<p>Insulation strategy, ventilation, temperature control solutions.</p>
						</div>
						<div class="topic">
							<strong>🏠 Interiors & Finishes</strong>
							<p>Layout decisions, materials selection, storage design for 750 sq ft.</p>
						</div>
					</div>
				</div>

				<div class="learning-options">
					<h3>Choose Your Path</h3>
					<div class="option-cards">
						<div class="option-card">
							<h4>📺 Video Only</h4>
							<p class="price">$49</p>
							<p>Watch the 4-hour recorded walkthrough at your own pace.</p>
							<ul>
								<li>✓ Lifetime access</li>
								<li>✓ Download available</li>
								<li>✓ PDF reference guide</li>
								<li>✓ Cost breakdown</li>
								<li>✓ Material list</li>
								<li>✓ Design files</li>
								<li>✓ Resource library updates</li>
							</ul>
							<a href="https://gumroad.com/l/sustainabox-walkthrough" class="btn btn-outline" target="_blank">Get Video</a>
						</div>

						<div class="option-card featured">
							<h4>🏡 + In-Person Stay</h4>
							<p class="price">$599–$799</p>
							<p>Weekend visit with live 4-hour walkthrough + all video benefits.</p>
							<ul>
								<li>✓ In-person walkthrough</li>
								<li>✓ Sleep in the space</li>
								<li>✓ Recorded version too</li>
								<li>✓ Educational materials</li>
								<li>✓ All templates</li>
								<li>✓ Community access</li>
								<li>✓ Personal Q&A</li>
							</ul>
							<a href="/stays" class="btn btn-primary">Book Stay</a>
						</div>
					</div>
				</div>

				<div class="honest-section">
					<h3>The Honest Part</h3>
					<div class="honest-grid">
						<div class="honest-card good">
							<h4>✓ The Good</h4>
							<ul>
								<li>Learn from actual systems and real decisions</li>
								<li>No theory—just what actually works</li>
								<li>Understand what we'd do differently and why</li>
								<li>See a completed, lived-in home</li>
								<li>Access to people who built it</li>
							</ul>
						</div>
						<div class="honest-card challenge">
							<h4>⚠️ The Realities</h4>
							<ul>
								<li>It's not a luxury project showcase</li>
								<li>You're learning from our specific choices—yours may differ</li>
								<li>Some systems are custom; not all are replicable</li>
								<li>Better suited for curious learners than casual observers</li>
								<li>4 hours is a deep dive, not a highlight reel</li>
							</ul>
						</div>
					</div>
					<p style="text-align: center; margin-top: 1.5rem; font-style: italic; color: var(--color-muted);">If you're looking for authentic knowledge and honest insights, this is for you. If you're looking for a polished marketing video, look elsewhere.</p>
				</div>

				<div class="instructors-section">
					<h3>Who's Teaching</h3>
					<div class="instructor-grid instructor-grid-3">
						<div class="instructor-card">
							<img src="/images/jen-instructor.jpg" alt="Jen Swidler" class="instructor-photo" />
							<h4>Jen Swidler</h4>
							<p class="role">Project Manager · Owner-to-Professional</p>
							<p>Started as a homeowner managing the Evergreen build. Then worked for the home builder as a consultant for 6 years, managing Sustainabox: subs, scheduling, cost control, quality.</p>
						</div>
						<div class="instructor-card">
							<img src="/images/cody-instructor.jpg" alt="Cody Swidler" class="instructor-photo" />
							<h4>Cody Swidler</h4>
							<p class="role">Enterprise Resilience · Design Strategy</p>
							<p>15+ years in enterprise resilience. Brought design thinking, systems approach, and risk mitigation to the project. Hands-on labor throughout the build.</p>
						</div>
						<div class="instructor-card">
							<img src="/images/skye-with-container.jpg" alt="Skye" class="instructor-photo" />
							<h4>Skye</h4>
							<p class="role">Design · Labor · Content Creator</p>
							<p>Design work and hands-on labor. Content creator for Travel365. Brings storytelling and visual perspective to how the build comes alive.</p>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- CTA -->
		<div class="final-cta">
			<h2>Not Sure Where to Start?</h2>
			<p>Schedule a free 30-minute call. We'll help you figure out what's right for your project.</p>
			<a href="/contact" class="btn btn-primary">Schedule a Call</a>
		</div>
	</section>

</Layout>

<style>
	.page-header {
		background: var(--color-navy);
		color: white;
		padding: 4rem 0;
		text-align: center;
	}

	.page-header h1 {
		color: white;
		margin-bottom: 1rem;
	}

	.page-header p {
		font-size: 1.1rem;
		opacity: 0.9;
	}

	.content-section {
		padding: 3rem 0;
	}

	.offering-section {
		margin-bottom: 5rem;
		padding-bottom: 3rem;
		border-bottom: 1px solid #e2e8f0;
	}

	.offering-section h2 {
		margin-bottom: 1rem;
		text-align: center;
	}

	.offering-section > p {
		text-align: center;
		color: var(--color-muted);
		margin-bottom: 2rem;
		font-size: 1.05rem;
	}

	/* Consulting */
	.consulting-offerings {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
		margin-bottom: 3rem;
	}

	.consulting-card {
		background: var(--color-warm);
		padding: 2rem;
		border-radius: 4px;
		border-left: 4px solid var(--color-blue);
		display: flex;
		flex-direction: column;
	}

	.consulting-card h3 {
		color: var(--color-navy);
		margin-bottom: 0.5rem;
	}

	.consulting-card .price {
		font-size: 1.2rem;
		font-weight: 600;
		color: var(--color-blue);
		margin-bottom: 1rem;
	}

	.consulting-card ul {
		list-style: none;
		padding: 0;
		margin: 1rem 0;
	}

	.consulting-card li {
		padding: 0.4rem 0;
		padding-left: 1.5rem;
		position: relative;
		color: var(--color-muted);
	}

	.consulting-card li::before {
		content: "✓";
		position: absolute;
		left: 0;
		color: var(--color-blue);
		font-weight: bold;
	}

	.consulting-card .deliverable {
		margin-top: auto;
		padding-top: 1rem;
		font-size: 0.9rem;
		color: var(--color-text);
	}

	.consulting-card .btn {
		margin-top: 1rem;
	}

	.why-consulting {
		background: linear-gradient(135deg, rgba(44,82,130,0.05), rgba(235,244,255,0.3));
		padding: 2rem;
		border-radius: 4px;
		margin-top: 2rem;
	}

	.why-consulting h3 {
		text-align: center;
		margin-bottom: 1.5rem;
	}

	.why-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 1.5rem;
	}

	.why-item h4 {
		color: var(--color-blue);
		margin-bottom: 0.5rem;
	}

	.why-item p {
		color: var(--color-muted);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	/* Learning */
	.learning-overview {
		display: grid;
		gap: 3rem;
	}

	.learning-section h3,
	.learning-options h3 {
		text-align: center;
		margin-bottom: 2rem;
	}

	.topics-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
	}

	.topic {
		background: var(--color-warm);
		padding: 1.5rem;
		border-radius: 4px;
		border-left: 4px solid var(--color-blue);
	}

	.topic strong {
		color: var(--color-navy);
		display: block;
		margin-bottom: 0.5rem;
	}

	.topic p {
		color: var(--color-muted);
		font-size: 0.95rem;
		margin: 0;
	}

	.option-cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
	}

	.option-card {
		background: var(--color-warm);
		padding: 2rem;
		border-radius: 4px;
		border-left: 4px solid var(--color-blue);
		display: flex;
		flex-direction: column;
	}

	.option-card.featured {
		border-left-color: var(--color-rust);
		background: linear-gradient(135deg, var(--color-warm), rgba(192, 86, 33, 0.05));
		transform: scale(1.02);
	}

	.option-card h4 {
		color: var(--color-navy);
		margin-bottom: 0.5rem;
	}

	.option-card .price {
		font-size: 1.3rem;
		font-weight: 600;
		color: var(--color-blue);
		margin-bottom: 1rem;
	}

	.option-card ul {
		list-style: none;
		padding: 0;
		margin: 1rem 0;
		flex-grow: 1;
	}

	.option-card li {
		padding: 0.4rem 0;
		color: var(--color-muted);
		font-size: 0.9rem;
	}

	.option-card .btn {
		margin-top: 1.5rem;
	}

	.honest-section {
		margin-top: 2rem;
		padding: 2rem;
		background: linear-gradient(135deg, rgba(44,82,130,0.05), rgba(235,244,255,0.3));
		border-radius: 4px;
	}

	.honest-section h3 {
		text-align: center;
		margin-bottom: 2rem;
	}

	.honest-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 2rem;
	}

	.honest-card {
		background: white;
		padding: 1.5rem;
		border-radius: 4px;
		border-left: 4px solid var(--color-blue);
	}

	.honest-card.good {
		border-left-color: var(--color-blue);
	}

	.honest-card.challenge {
		border-left-color: var(--color-rust);
	}

	.honest-card h4 {
		color: var(--color-navy);
		margin-bottom: 1rem;
	}

	.honest-card ul {
		list-style: none;
		padding: 0;
	}

	.honest-card li {
		padding: 0.5rem 0;
		padding-left: 1.5rem;
		position: relative;
		color: var(--color-muted);
		font-size: 0.9rem;
	}

	.honest-card li::before {
		position: absolute;
		left: 0;
		font-weight: bold;
	}

	.honest-card.good li::before {
		content: "✓";
		color: var(--color-blue);
	}

	.honest-card.challenge li::before {
		content: "•";
		color: var(--color-rust);
	}

	.instructors-section {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid #e2e8f0;
	}

	.instructors-section h3 {
		text-align: center;
		margin-bottom: 2rem;
	}

	.instructor-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
	}

	.instructor-card {
		background: var(--color-warm);
		padding: 1.5rem;
		border-radius: 4px;
		border-left: 4px solid var(--color-blue);
	}

	.instructor-photo {
		width: 100%;
		height: 250px;
		object-fit: cover;
		border-radius: 4px;
		margin-bottom: 1rem;
		display: block;
	}

	.instructor-card h4 {
		color: var(--color-navy);
		margin-bottom: 0.25rem;
		font-size: 1.1rem;
	}

	.instructor-card .role {
		color: var(--color-blue);
		font-size: 0.85rem;
		font-weight: 600;
		margin-bottom: 0.75rem;
		display: block;
	}

	.instructor-card p {
		color: var(--color-muted);
		font-size: 0.9rem;
		line-height: 1.6;
		margin: 0;
	}

	/* Products */
	.products-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 2rem;
	}

	.product-card {
		background: var(--color-warm);
		padding: 2rem;
		border-radius: 4px;
		border-left: 4px solid var(--color-blue);
		display: flex;
		flex-direction: column;
	}

	.product-card.bundle {
		border-left-color: var(--color-rust);
		background: linear-gradient(135deg, var(--color-warm), rgba(192, 86, 33, 0.05));
	}

	.product-card h3 {
		color: var(--color-navy);
		margin-bottom: 0.5rem;
	}

	.product-card .price {
		font-size: 1.2rem;
		font-weight: 600;
		color: var(--color-blue);
		margin-bottom: 0.5rem;
	}

	.product-card .savings {
		color: var(--color-rust);
		font-size: 0.9rem;
		font-weight: 600;
	}

	.product-card ul {
		list-style: none;
		padding: 0;
		margin: 1rem 0;
		flex-grow: 1;
	}

	.product-card li {
		padding: 0.4rem 0;
		padding-left: 1.5rem;
		position: relative;
		color: var(--color-muted);
		font-size: 0.95rem;
	}

	.product-card li::before {
		content: "✓";
		position: absolute;
		left: 0;
		color: var(--color-blue);
		font-weight: bold;
	}

	.product-card .btn {
		margin-top: 1.5rem;
	}

	/* Final CTA */
	.final-cta {
		margin-top: 4rem;
		padding: 3rem;
		background: var(--color-blue);
		color: white;
		border-radius: 4px;
		text-align: center;
	}

	.final-cta h2 {
		color: white;
		margin-bottom: 1rem;
	}

	.final-cta p {
		color: white;
		opacity: 0.95;
		margin-bottom: 1.5rem;
	}

	.final-cta .btn {
		background: white;
		color: var(--color-blue);
	}

	.final-cta .btn:hover {
		background: var(--color-sky);
	}

	/* Mobile */
	@media (max-width: 768px) {
		.option-card.featured {
			transform: scale(1);
		}

		.consulting-offerings,
		.topics-grid,
		.option-cards,
		.instructor-grid,
		.products-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
