---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Stay & Learn — Sustainabox">

	<!-- Hero -->
	<header class="hero-stays">
		<div class="hero-overlay">
			<div class="hero-content">
				<h1>Stay & Learn</h1>
				<p class="hero-tagline">Experience Resilient Living</p>
				<p class="hero-sub">A weekend at Sustainabox isn't a vacation. It's an education. Sleep in a shipping container home. Learn how it was built. Understand what sustainable really means.</p>
				<a href="#booking" class="btn btn-primary">Check Availability</a>
			</div>
		</div>
	</header>

	<!-- The Experience -->
	<section class="experience-section">
		<div class="container">
			<h2>What You're Getting</h2>
			<p>Not your typical Airbnb. This is a chance to step inside alternative living and understand it from the ground up.</p>

			<div class="experience-grid">
				<div class="exp-card">
					<h3>🏠 Authentic Container Home</h3>
					<p>Sleep in a real, lived-in shipping container home. No gimmicks. You're experiencing actual sustainable design—the good, the bad, the real.</p>
				</div>
				<div class="exp-card">
					<h3>🛠️ 4-Hour Building Walkthrough</h3>
					<p>Private tour + detailed explanation of every system. From foundation to plumbing to electrical. Learn what works, what we'd do differently, and why.</p>
				</div>
				<div class="exp-card">
					<h3>🌍 Resilience By Design</h3>
					<p>Built WITH off-grid principles but connected to utilities (water, septic, electric, cell internet). Smart efficient design + modern comfort = no roughing it.</p>
				</div>
				<div class="exp-card">
					<h3>📚 Honest Education</h3>
					<p>We share the real challenges. The mistakes. The lessons. Not a sales pitch—a genuine knowledge transfer from people who've done it.</p>
				</div>
				<div class="exp-card">
					<h3>🎯 Community Connection</h3>
					<p>Join a network of builders, designers, and entrepreneurs thinking differently about housing. Connections made here matter.</p>
				</div>
				<div class="exp-card">
					<h3>📍 Stunning Hill Country Location</h3>
					<p>Located in the Texas Hill Country with views overlooking water and landscape. Work, reflect, or just slow down in a beautiful setting.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- The Space -->
	<section class="space-section">
		<div class="container">
			<h2>The Property</h2>
			<p>Three shipping containers configured as a modern, functional home. Designed for living, not just surviving.</p>

			<div class="space-details">
				<div class="space-item">
					<h4>Main Living (C1)</h4>
					<p>40-foot HC container. Kitchen, living room, half bathroom. Where the communal experience happens.</p>
				</div>
				<div class="space-item">
					<h4>Bedrooms & Bath (C2)</h4>
					<p>40-foot HC container. Two bedrooms, full bathroom, utility space. Comfortable, private, and efficient.</p>
				</div>
				<div class="space-item">
					<h4>Flex Space (C3) — Mobile</h4>
					<p>20-foot HC container on a trailer. Like a 5th wheel RV. Office, meditation space, or extra guest room. Part of the deck courtyard.</p>
				</div>
				<div class="space-item">
					<h4>Outdoor Living</h4>
					<p>Deck and courtyard space. The real living happens outside. Room to gather, reflect, and experience the landscape.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Amenities -->
	<section class="amenities-section">
		<div class="container">
			<h2>What's Included</h2>

			<div class="amenities-grid">
				<div class="amenity">
					<strong>✓ 4-Hour Building Walkthrough</strong>
					<p>Hosted by the people who designed and built it. Full access to the property and systems.</p>
				</div>
				<div class="amenity">
					<strong>✓ Educational Materials</strong>
					<p>Cost breakdowns, design files, decisions rationale. Take the knowledge with you.</p>
				</div>
				<div class="amenity">
					<strong>✓ WiFi & Modern Amenities</strong>
					<p>Fast internet, modern kitchen, hot showers. Comfortable doesn't mean sacrifice.</p>
				</div>
				<div class="amenity">
					<strong>✓ Full Kitchen Access</strong>
					<p>Cook your own meals or arrange catering. Coffee, tea, basics provided.</p>
				</div>
				<div class="amenity">
					<strong>✓ Workspace</strong>
					<p>Dedicated office/flex space. Perfect for remote workers or creators.</p>
				</div>
				<div class="amenity">
					<strong>✓ Community Access</strong>
					<p>Membership in the Sustainabox Community during and after your stay. Ongoing support and connection.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- The Real Talk -->
	<section class="real-talk-section">
		<div class="container">
			<h2>The Honest Part</h2>
			<p>We're not selling you a fantasy. Here's what you need to know:</p>

			<div class="real-talk-grid">
				<div class="card good">
					<h4>✓ The Good</h4>
					<ul>
						<li>Lower utility costs than traditional homes</li>
						<li>Surprisingly spacious and functional</li>
						<li>Durable, weather-resistant construction</li>
						<li>Beautiful setting and views</li>
						<li>Unique experience you can't get elsewhere</li>
					</ul>
				</div>
				<div class="card challenge">
					<h4>⚠️ The Realities</h4>
					<ul>
						<li>It's not a luxury resort. It's a real, lived-in home.</li>
						<li>Some noise transmission between spaces (container living)</li>
						<li>Weather affects outdoor comfort on the deck</li>
						<li>Internet is cell-based (fast where we are, plan accordingly)</li>
						<li>Better suited for curious learners than passive relaxers</li>
					</ul>
				</div>
			</div>

			<p style="text-align: center; margin-top: 2rem; font-style: italic; color: var(--color-muted);">
				If you're looking for a transformative experience and genuine knowledge about alternative housing, you're in the right place. If you're looking for a standard luxury Airbnb, there are better options.
			</p>
		</div>
	</section>

	<!-- Pricing -->
	<section class="pricing-section" id="booking">
		<div class="container">
			<h2>Pricing & Booking</h2>

			<div class="pricing-grid">
				<div class="pricing-card">
					<h3>Weekend Stay</h3>
					<p class="price">$599–$799</p>
					<p>Friday evening – Sunday afternoon</p>
					<ul>
						<li>Accommodations for 2-4 people</li>
						<li>4-hour building walkthrough (Saturday)</li>
						<li>Educational materials</li>
						<li>Community membership</li>
					</ul>
					<a href="https://www.airbnb.com/your-listing" class="btn btn-outline" target="_blank">View on Airbnb</a>
				</div>

				<div class="pricing-card featured">
					<h3>Week-Long Immersion</h3>
					<p class="price">$2,400–$3,200</p>
					<p>7 nights, deeper learning</p>
					<ul>
						<li>Full week accommodations</li>
						<li>2 full-day building walkthroughs</li>
						<li>Systems deep-dive workshop</li>
						<li>One-on-one consultation</li>
						<li>Community membership + priority access</li>
					</ul>
					<a href="https://www.airbnb.com/your-listing" class="btn btn-primary" target="_blank">Book on Airbnb</a>
				</div>

				<div class="pricing-card">
					<h3>Group Retreat</h3>
					<p class="price">Custom pricing</p>
					<p>For teams & organizations</p>
					<ul>
						<li>Full property rental</li>
						<li>Custom workshop design</li>
						<li>Catering options</li>
						<li>Team building focus</li>
					</ul>
					<a href="/contact" class="btn btn-outline">Inquire</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Who Should Come -->
	<section class="who-section">
		<div class="container">
			<h2>Who This Is For</h2>
			<p>Sustainabox isn't for everyone. It's for:</p>

			<div class="who-grid">
				<div class="who-item">
					<strong>Curious Builders</strong> — People designing their own home or project. You'll get real answers.
				</div>
				<div class="who-item">
					<strong>Sustainability Advocates</strong> — Want to see alternative housing done right (and honestly).
				</div>
				<div class="who-item">
					<strong>Remote Workers</strong> — Who want a workspace with a view and meaning.
				</div>
				<div class="who-item">
					<strong>Architects & Designers</strong> — Looking for case studies and inspiration.
				</div>
				<div class="who-item">
					<strong>Community Seekers</strong> — Want connection with like-minded builders and thinkers.
				</div>
				<div class="who-item">
					<strong>Learning Enthusiasts</strong> — Who see travel as education, not just relaxation.
				</div>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="cta-section">
		<div class="container">
			<h2>Ready to Experience It?</h2>
			<p>Check availability on Airbnb or contact us for group bookings and custom stays.</p>
			<div class="cta-buttons">
				<a href="https://www.airbnb.com/your-listing" class="btn btn-primary" target="_blank">View on Airbnb</a>
				<a href="/contact" class="btn btn-outline">Custom Inquiry</a>
			</div>
		</div>
	</section>

</Layout>

<style>
	.hero-stays {
		background: url('/images/PXL_20260513_152354256~2.jpg.jpeg') center/cover no-repeat;
		min-height: 70vh;
		position: relative;
	}

	.hero-overlay {
		background: linear-gradient(135deg, rgba(26,39,68,0.85), rgba(44,82,130,0.7));
		min-height: 70vh;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.hero-content {
		text-align: center;
		color: white;
		padding: 2rem;
		max-width: 700px;
	}

	.hero-stays h1 {
		font-size: 3.5rem;
		font-weight: 700;
		margin-bottom: 0.25rem;
		line-height: 1.1;
		color: white;
	}

	.hero-tagline {
		font-family: var(--font-heading);
		font-size: 1.3rem;
		font-weight: 400;
		opacity: 0.95;
		margin-bottom: 1rem;
		font-style: italic;
		color: white;
	}

	.hero-sub {
		font-size: 1.1rem;
		line-height: 1.8;
		opacity: 0.9;
		margin-bottom: 2rem;
		color: white;
	}

	/* Experience Section */
	.experience-section {
		padding: 5rem 0;
		background: white;
	}

	.experience-section h2 {
		text-align: center;
		margin-bottom: 1.5rem;
	}

	.experience-section > .container > p {
		text-align: center;
		font-size: 1.1rem;
		margin-bottom: 3rem;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
		color: var(--color-muted);
	}

	.experience-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
	}

	.exp-card {
		background: var(--color-warm);
		padding: 2rem;
		border-radius: 4px;
		border-left: 4px solid var(--color-blue);
	}

	.exp-card h3 {
		color: var(--color-blue);
		margin-bottom: 1rem;
		font-size: 1.1rem;
	}

	.exp-card p {
		color: var(--color-muted);
		line-height: 1.7;
		font-size: 0.95rem;
	}

	/* Space Section */
	.space-section {
		padding: 5rem 0;
		background: var(--color-warm);
	}

	.space-section h2 {
		text-align: center;
		margin-bottom: 1.5rem;
	}

	.space-section > .container > p {
		text-align: center;
		color: var(--color-muted);
		margin-bottom: 3rem;
	}

	.space-details {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 2rem;
	}

	.space-item {
		background: white;
		padding: 2rem;
		border-radius: 4px;
		border-top: 3px solid var(--color-blue);
	}

	.space-item h4 {
		color: var(--color-navy);
		margin-bottom: 0.75rem;
	}

	.space-item p {
		color: var(--color-muted);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	/* Amenities Section */
	.amenities-section {
		padding: 5rem 0;
		background: white;
	}

	.amenities-section h2 {
		text-align: center;
		margin-bottom: 3rem;
	}

	.amenities-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 2rem;
	}

	.amenity {
		background: var(--color-warm);
		padding: 1.5rem;
		border-radius: 4px;
		border-left: 4px solid var(--color-blue);
	}

	.amenity strong {
		color: var(--color-blue);
		display: block;
		margin-bottom: 0.75rem;
	}

	.amenity p {
		color: var(--color-muted);
		font-size: 0.9rem;
		line-height: 1.6;
	}

	/* Real Talk Section */
	.real-talk-section {
		padding: 5rem 0;
		background: var(--color-warm);
	}

	.real-talk-section h2 {
		text-align: center;
		margin-bottom: 1.5rem;
	}

	.real-talk-section > .container > p {
		text-align: center;
		color: var(--color-muted);
		margin-bottom: 3rem;
	}

	.real-talk-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
		margin-bottom: 2rem;
	}

	.card {
		background: white;
		padding: 2rem;
		border-radius: 4px;
		border-left: 4px solid;
	}

	.card.good {
		border-left-color: #22c55e;
	}

	.card.challenge {
		border-left-color: #f97316;
	}

	.card h4 {
		color: var(--color-navy);
		margin-bottom: 1rem;
	}

	.card ul {
		list-style: none;
		padding: 0;
	}

	.card li {
		padding: 0.5rem 0;
		padding-left: 1.5rem;
		position: relative;
		color: var(--color-muted);
		font-size: 0.9rem;
	}

	.card li::before {
		position: absolute;
		left: 0;
		font-weight: bold;
	}

	.card.good li::before {
		content: "✓";
		color: #22c55e;
	}

	.card.challenge li::before {
		content: "•";
		color: #f97316;
	}

	/* Pricing Section */
	.pricing-section {
		padding: 5rem 0;
		background: white;
	}

	.pricing-section h2 {
		text-align: center;
		margin-bottom: 3rem;
	}

	.pricing-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
	}

	.pricing-card {
		background: var(--color-warm);
		padding: 2rem;
		border-radius: 4px;
		border-left: 4px solid var(--color-blue);
		display: flex;
		flex-direction: column;
	}

	.pricing-card.featured {
		border-left-color: var(--color-rust);
		background: linear-gradient(135deg, var(--color-warm), rgba(192, 86, 33, 0.05));
		transform: scale(1.05);
	}

	.pricing-card h3 {
		color: var(--color-navy);
		margin-bottom: 0.5rem;
	}

	.pricing-card .price {
		font-size: 1.8rem;
		font-weight: 700;
		color: var(--color-blue);
		margin: 0.5rem 0 1rem 0;
	}

	.pricing-card p {
		font-size: 0.95rem;
		color: var(--color-muted);
		margin-bottom: 1.5rem;
	}

	.pricing-card ul {
		list-style: none;
		padding: 0;
		margin-bottom: 1.5rem;
		flex-grow: 1;
	}

	.pricing-card li {
		padding: 0.4rem 0;
		padding-left: 1.5rem;
		position: relative;
		font-size: 0.9rem;
		color: var(--color-muted);
	}

	.pricing-card li::before {
		content: "✓";
		position: absolute;
		left: 0;
		color: var(--color-blue);
		font-weight: bold;
	}

	.pricing-card .btn {
		align-self: flex-start;
	}

	/* Who Section */
	.who-section {
		padding: 5rem 0;
		background: var(--color-warm);
	}

	.who-section h2 {
		text-align: center;
		margin-bottom: 1.5rem;
	}

	.who-section > .container > p {
		text-align: center;
		color: var(--color-muted);
		margin-bottom: 3rem;
	}

	.who-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
	}

	.who-item {
		background: white;
		padding: 1.5rem;
		border-radius: 4px;
		border-left: 4px solid var(--color-blue);
		color: var(--color-muted);
		line-height: 1.7;
	}

	.who-item strong {
		color: var(--color-navy);
		display: block;
		margin-bottom: 0.5rem;
	}

	/* CTA Section */
	.cta-section {
		padding: 5rem 0;
		background: var(--color-navy);
		color: white;
		text-align: center;
	}

	.cta-section h2 {
		color: white;
		margin-bottom: 1rem;
	}

	.cta-section p {
		font-size: 1.1rem;
		margin-bottom: 2rem;
		opacity: 0.9;
	}

	.cta-buttons {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.cta-section .btn-primary {
		background: white;
		color: var(--color-navy);
	}

	.cta-section .btn-primary:hover {
		background: var(--color-sky);
	}

	/* Mobile */
	@media (max-width: 768px) {
		.hero-stays h1 {
			font-size: 2.2rem;
		}

		.pricing-card.featured {
			transform: scale(1);
		}

		.cta-buttons {
			flex-direction: column;
		}

		.cta-buttons .btn {
			width: 100%;
		}
	}
</style>
