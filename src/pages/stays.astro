---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Stay & Learn — Sustainabox" description="Spend a weekend with the people who built a real container home. Stay, explore every system, and leave with ideas you can actually use." image="/images/PXL_20260513_152354256~2.jpg.jpeg">

	<!-- Hero -->
	<header class="page-hero" style="background-image: url('/images/PXL_20260513_152354256~2.jpg.jpeg');">
		<div class="page-hero-inner">
			<span class="eyebrow">Stay &amp; Learn</span>
			<h1>Spend a Weekend With the People Who Built It</h1>
			<p>Stay in a real container home. Learn how it was designed, built, and lived in. Leave with ideas you can actually use.</p>
			<a href="/book" class="btn btn-white" style="margin-top: 1.75rem;">Request a Stay</a>
		</div>
	</header>

	<!-- Differentiator -->
	<section class="differentiator-section">
		<div class="container">
			<div class="diff-inner">
				<p class="diff-statement">This isn't a vacation rental with a gimmick.</p>
				<p>Sustainabox is a real home built over several years by people who documented every success, mistake, and lesson. Your stay includes access to that experience—so you leave with ideas you can actually use.</p>
			</div>
		</div>
	</section>

	<!-- What You're Getting -->
	<section class="experience-section">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow">What's Included</span>
				<h2>More Than a Place to Stay</h2>
			</div>

			<div class="experience-grid">
				<div class="exp-card">
					<h3>Stay in a Real Container Home</h3>
					<p>Not a showroom. Not a concept. The home we designed, built, and live in — three shipping containers configured into a modern, comfortable space.</p>
				</div>
				<div class="exp-card">
					<h3>Learn Every System</h3>
					<p>Spend four hours exploring how we built Sustainabox — from foundation to finishes — with honest conversations about what worked and what we'd change.</p>
				</div>
				<div class="exp-card">
					<h3>Modern, Comfortable Living</h3>
					<p>Fast Wi-Fi, full kitchen, climate control, and everything you'd expect from a modern home — just built differently.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Pricing -->
	<section class="pricing-section">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow">Pricing</span>
				<h2>The Sustainabox Experience</h2>
			</div>

			<div class="pricing-card">
				<div class="pricing-info">
					<p class="price">$699</p>
					<p class="price-sub">Friday evening – Sunday afternoon · Up to 4 guests</p>
					<ul>
						<li>Friday–Sunday stay at Sustainabox</li>
						<li>4-hour build walkthrough with Jenna — or recorded tour when we're traveling</li>
						<li>Q&A with the builders</li>
						<li>Design resources and build documentation</li>
					</ul>
				</div>
				<div class="pricing-cta">
					<a href="/book" class="btn btn-primary">Request Dates</a>
					<p>We'll confirm availability within 24 hours.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Meet Your Hosts -->
	<section class="hosts-section">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow">Your Hosts</span>
				<h2>Meet Your Hosts</h2>
			</div>

			<div class="hosts-grid">
				<div class="host-card">
					<h3>Jenna Swidler</h3>
					<span class="host-role">Builder · General Contractor</span>
					<p>Jenna managed the Sustainabox build from foundation to finishes and documented the entire journey. She knows every system, every trade, every challenge, and every lesson learned.</p>
				</div>

				<div class="host-card">
					<h3>Cody Swidler</h3>
					<span class="host-role">Founder · Designer</span>
					<p>Cody designed Sustainabox in SketchUp and helped bring the vision to life. Today, he's focused on growing Sustainabox into a resource for smarter container home design and resilient living.</p>
				</div>

				<div class="host-card">
					<h3>Skye</h3>
					<span class="host-role">Creative &amp; Builder</span>
					<p>Skye contributed to the design, construction, and storytelling behind Sustainabox, helping capture the project from concept to completion.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Walkthrough Options -->
	<section class="walkthrough-section">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow">The Walkthrough</span>
				<h2>Your Learning Experience</h2>
				<p>Every stay includes the 4-hour walkthrough — delivered one of two ways depending on whether we're on-site.</p>
			</div>

			<div class="options-grid">
				<div class="option-card">
					<h3>In-Person Walkthrough</h3>
					<p class="option-timing">When hosts are available</p>
					<p>Jenna leads you through every system, material decision, and tradeoff — live, with real-time Q&A.</p>
				</div>
				<div class="option-card">
					<h3>Recorded Tour</h3>
					<p class="option-timing">When hosts are traveling</p>
					<p>Same walkthrough, on your own schedule — projected on-site with drinks and snacks stocked.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Availability Calendar -->
	<section class="calendar-section">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow">Availability</span>
				<h2>Check Open Dates</h2>
				<p>Reach out to confirm and reserve.</p>
			</div>

			<!-- JEN: Replace this placeholder div with your Google Calendar embed code.
			     In Google Calendar → Settings → your calendar → "Integrate calendar" → copy the iframe embed code.
			     Set width="100%" and height="600" on the iframe. -->
			<div class="calendar-placeholder">
				<div class="calendar-placeholder-inner">
					<p><strong>Calendar coming soon</strong></p>
					<p>Live availability will appear here once we connect our booking calendar.</p>
					<a href="/book" class="btn btn-outline" style="margin-top: 1.5rem; display: inline-block;">Request a Stay</a>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="cta-section">
		<div class="container">
			<h2>Ready to Experience It?</h2>
			<p>Reach out with your dates and we'll confirm availability within 24 hours.</p>
			<a href="/book" class="btn btn-primary">Request a Stay</a>
		</div>
	</section>

</Layout>

<style>
	/* Differentiator */
	.differentiator-section {
		padding: 4rem 0;
		background: var(--color-navy);
		color: white;
	}

	.diff-inner {
		max-width: 720px;
		margin: 0 auto;
		text-align: center;
	}

	.diff-statement {
		font-size: 1.4rem;
		font-weight: 700;
		color: white;
		margin-bottom: 1rem;
		font-family: var(--font-heading);
	}

	.diff-inner p {
		color: rgba(255,255,255,0.85);
		font-size: 1.05rem;
		line-height: 1.8;
		margin: 0;
	}

	/* Experience */
	.experience-section {
		padding: 5rem 0;
		background: white;
	}

	.experience-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 2rem;
	}

	.exp-card {
		padding: 1.5rem 0 1.5rem 1.5rem;
		border-left: 3px solid var(--color-blue);
	}

	.exp-card h3 {
		color: var(--color-navy);
		margin-bottom: 0.75rem;
		font-size: 1.1rem;
	}

	.exp-card p {
		color: var(--color-muted);
		line-height: 1.7;
		font-size: 0.95rem;
		margin: 0;
	}

	/* Pricing */
	.pricing-section {
		padding: 5rem 0;
		background: var(--color-warm);
	}

	.pricing-card {
		background: white;
		border: 1px solid #e5e7eb;
		border-top: 3px solid var(--color-blue);
		border-radius: 4px;
		padding: 2.5rem;
		display: flex;
		gap: 3rem;
		align-items: flex-start;
		max-width: 860px;
	}

	.pricing-info {
		flex: 1;
	}

	.price {
		font-size: 2rem;
		font-weight: 700;
		color: var(--color-blue);
		margin: 0 0 0.25rem;
		font-family: var(--font-heading);
	}

	.price-sub {
		color: var(--color-muted);
		font-size: 0.9rem;
		margin-bottom: 1.5rem;
	}

	.pricing-info ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.pricing-info li {
		padding: 0.4rem 0 0.4rem 1.5rem;
		position: relative;
		color: var(--color-muted);
		font-size: 0.95rem;
	}

	.pricing-info li::before {
		content: "✓";
		position: absolute;
		left: 0;
		color: var(--color-blue);
		font-weight: bold;
	}

	.pricing-cta {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
		flex-shrink: 0;
	}

	.pricing-cta p {
		color: var(--color-muted);
		font-size: 0.85rem;
		margin: 0;
	}

	/* Hosts */
	.hosts-section {
		padding: 5rem 0;
		background: white;
	}

	.hosts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 2rem;
	}

	.host-card {
		padding: 2rem;
		background: var(--color-warm);
		border-left: 3px solid var(--color-blue);
		border-radius: 4px;
	}

	.host-card h3 {
		color: var(--color-navy);
		margin-bottom: 0.25rem;
		font-size: 1.15rem;
	}

	.host-role {
		display: block;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-blue);
		margin-bottom: 0.75rem;
	}

	.host-card p {
		color: var(--color-muted);
		line-height: 1.7;
		font-size: 0.9rem;
		margin: 0;
	}

	/* Walkthrough */
	.walkthrough-section {
		padding: 5rem 0;
		background: var(--color-warm);
	}

	.options-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 2rem;
	}

	.option-card {
		background: white;
		padding: 2rem;
		border-left: 3px solid var(--color-blue);
		border-radius: 4px;
	}

	.option-card h3 {
		color: var(--color-navy);
		margin-bottom: 0.25rem;
		font-size: 1.1rem;
	}

	.option-timing {
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-blue);
		margin-bottom: 0.75rem;
	}

	.option-card p:last-child {
		color: var(--color-muted);
		font-size: 0.95rem;
		line-height: 1.7;
		margin: 0;
	}

	/* Calendar */
	.calendar-section {
		padding: 5rem 0;
		background: white;
		border-bottom: 1px solid #e2e8f0;
	}

	.calendar-placeholder {
		max-width: 900px;
		margin: 0 auto;
		border: 2px dashed #cbd5e0;
		border-radius: 4px;
		background: var(--color-warm);
		overflow: hidden;
	}

	.calendar-placeholder-inner {
		padding: 4rem 2rem;
		text-align: center;
		color: var(--color-muted);
	}

	.calendar-placeholder-inner p {
		margin: 0.5rem 0;
	}

	.calendar-placeholder-inner strong {
		color: var(--color-navy);
		font-size: 1.1rem;
	}

	.calendar-placeholder iframe {
		width: 100%;
		height: 600px;
		border: none;
		display: block;
	}

	/* CTA */
	.cta-section {
		padding: 5rem 0;
		background: var(--color-navy);
		color: white;
		text-align: center;
	}

	.cta-section h2 {
		color: white;
		margin-bottom: 1rem;
	}

	.cta-section p {
		font-size: 1.05rem;
		margin-bottom: 2rem;
		opacity: 0.85;
	}

	.cta-section .btn-primary {
		background: white;
		color: var(--color-navy);
	}

	/* Mobile */
	@media (max-width: 768px) {
		.experience-grid,
		.hosts-grid,
		.options-grid {
			grid-template-columns: 1fr;
		}

		.pricing-card {
			flex-direction: column;
			gap: 2rem;
		}

		.diff-statement {
			font-size: 1.2rem;
		}
	}
</style>
