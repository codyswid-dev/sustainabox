---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Book Your Stay — Sustainabox" description="Premium Airbnb experience with expert-led 4-hour walkthrough. Weekend stays $599-$799. Learn resilient design from experienced homebuilders in Texas Hill Country.">

	<header class="page-hero" style="background-image: url('/images/deck 2.jpeg');">
		<div class="page-hero-inner">
			<span class="eyebrow">Book Your Stay</span>
			<h1>Reserve Your Weekend</h1>
			<p>Premium experience. Expert-led walkthrough. Real learning.</p>
		</div>
	</header>

	<section class="container content-section">
		<div class="booking-wrapper">
			<div class="booking-info">
				<h2>Sustainabox Stays</h2>
				<p><strong>Weekend Experience</strong><br>Friday evening through Sunday afternoon</p>

				<h3 style="margin-top: 1.5rem;">Base Stay</h3>
				<ul>
					<li>Accommodations for 2–4 guests</li>
					<li>Educational materials and design documentation</li>
					<li>Full access to property</li>
				</ul>

				<h3 style="margin-top: 1.5rem;">4-Hour Walkthrough (Add-on)</h3>
				<p><strong>Option A: In-Person Walkthrough</strong></p>
				<ul style="margin-bottom: 1.5rem;">
					<li>Saturday morning: expert-led tour of all systems</li>
					<li>Q&A with builders and designers</li>
					<li>Design documentation and specs</li>
					<li><strong>Included with stay</strong> (when hosts are available)</li>
				</ul>

				<p><strong>Option B: Video Walkthrough + Projector</strong></p>
				<ul>
					<li>4-hour recorded tour of all systems</li>
					<li>Projector setup in main living area</li>
					<li>Fridge stocked with drinks & snacks</li>
					<li><strong>$150 discount</strong> vs. in-person stay</li>
					<li>*(Available when hosts are traveling)*</li>
				</ul>

				<p style="margin-top: 2rem;"><strong>Pricing</strong><br>
				Base stay: $599–$799 (depending on group size & season)<br>
				In-person walkthrough: Included<br>
				Video walkthrough: $150 discount applied</p>

				<div class="booking-divider"></div>

				<h3>Get in Touch</h3>
				<p>To check availability and book your stay, reach out to the Sustainabox team:</p>

				<a href="mailto:jenswid@gmail.com,codyswid@gmail.com?subject=Sustainabox%20Stay%20Inquiry" class="btn btn-primary" style="display: inline-block; margin: 1.5rem 0;">Request Your Stay</a>

				<p style="font-size: 0.9rem; color: var(--color-muted);">Include your preferred dates and number of guests. We typically respond within 24 hours.</p>
				<p style="font-size: 0.85rem; color: var(--color-muted); margin-top: 1rem;"><em>Coming soon: hello@sustainabox.org</em></p>

				<div class="booking-divider" style="margin: 2rem 0;"></div>

				<h3>Payment</h3>
				<p>We accept Venmo for deposit or full payment:</p>
				<p style="margin: 1rem 0;"><strong>@[JEN_VENMO_USERNAME]</strong></p>
				<p style="font-size: 0.9rem; color: var(--color-muted);">Please note: Payment details will be confirmed when we receive your inquiry.</p>
			</div>

			<div class="booking-preview">
				<div class="preview-box">
					<img src="/images/deck%202.jpeg" alt="Sustainabox outdoor living space" style="width: 100%; border-radius: 8px; margin-bottom: 1rem;">
					<h3>What to Expect</h3>
					<ul>
						<li><strong>Friday evening:</strong> Arrival, orientation, dinner</li>
						<li><strong>Saturday morning:</strong> 4-hour guided walkthrough + Q&A</li>
						<li><strong>Saturday afternoon:</strong> Free time, explore, relax on deck</li>
						<li><strong>Sunday:</strong> Breakfast, discussions, depart by noon</li>
					</ul>

					<h3 style="margin-top: 2rem;">Who Should Come?</h3>
					<ul>
						<li>Builders and designers researching container homes</li>
						<li>Anyone considering alternative housing</li>
						<li>People interested in resilience and sustainable design</li>
						<li>Educators and content creators</li>
						<li>Curious learners ready to ask hard questions</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

</Layout>

<style>
	.content-section {
		padding: 4rem 0;
	}

	.booking-wrapper {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		max-width: 1200px;
		margin: 0 auto;
	}

	.booking-info h2 {
		margin-bottom: 1.5rem;
	}

	.booking-info p {
		color: var(--color-muted);
		margin-bottom: 1rem;
		line-height: 1.7;
	}

	.booking-info ul {
		list-style: none;
		padding: 0;
		margin: 1.5rem 0;
	}

	.booking-info li {
		padding: 0.5rem 0;
		padding-left: 1.5rem;
		position: relative;
		color: var(--color-muted);
	}

	.booking-info li::before {
		content: "✓";
		position: absolute;
		left: 0;
		color: var(--color-blue);
		font-weight: bold;
	}

	.booking-divider {
		height: 1px;
		background: #e2e8f0;
		margin: 2rem 0;
	}

.booking-preview {
		position: sticky;
		top: 100px;
		height: fit-content;
	}

	.preview-box {
		background: white;
		padding: 2rem;
		border: 1px solid #e2e8f0;
		border-radius: 8px;
	}

	.preview-box h3 {
		color: var(--color-navy);
		margin-bottom: 1rem;
		font-size: 1.15rem;
	}

	.preview-box ul {
		list-style: none;
		padding: 0;
	}

	.preview-box li {
		padding: 0.6rem 0;
		color: var(--color-muted);
		font-size: 0.9rem;
		line-height: 1.6;
	}

	@media (max-width: 768px) {
		.booking-wrapper {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.booking-preview {
			position: static;
		}

		.contact-links {
			flex-direction: column;
		}
	}
</style>
