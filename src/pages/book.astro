---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Book Your Stay — Sustainabox" description="Weekend stays at a real container home with an expert-led 4-hour build walkthrough. $699 for up to 4 guests. Learn resilient design from experienced homebuilders in Texas Hill Country.">

	<header class="page-hero" style="background-image: url('/images/deck-2.webp');">
		<div class="page-hero-inner">
			<span class="eyebrow">Book Your Stay</span>
			<h1>Reserve Your Weekend</h1>
			<p>Premium experience. Expert-led walkthrough. Real learning.</p>
		</div>
	</header>

	<!-- Availability Calendar -->
	<section class="calendar-section">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow">Availability</span>
				<h2>Check Open Dates</h2>
				<p>Green dates are available. Reach out to confirm and reserve.</p>
			</div>

			<!-- JEN: Replace this placeholder div with your Google Calendar embed code.
			     In Google Calendar → Settings → your calendar → "Integrate calendar" → copy the iframe embed code.
			     Set width="100%" and height="600" on the iframe. -->
			<div class="calendar-placeholder">
				<div class="calendar-placeholder-inner">
					<div class="calendar-icon">📅</div>
					<p><strong>Calendar coming soon</strong></p>
					<p>Live availability will appear here once we connect our booking calendar.</p>
				</div>
			</div>

		</div>
	</section>

	<!-- Booking Details -->
	<section class="container content-section">
		<div class="booking-wrapper">
			<div class="booking-info">
				<h2>The Sustainabox Experience</h2>
				<p class="price-display">$699</p>
				<p>Friday evening through Sunday afternoon · Up to 4 guests</p>

				<ul style="margin-top: 1.5rem;">
					<li>Friday–Sunday stay at Sustainabox</li>
					<li>4-hour build walkthrough with Jenna — or recorded tour when we're traveling</li>
					<li>Q&A with the builders</li>
					<li>Design resources and build documentation</li>
				</ul>

				<div class="booking-divider"></div>

				<h3>Get in Touch</h3>
				<p>See a date that works? Reach out and we'll confirm within 24 hours.</p>

				<a href="mailto:jenswid@gmail.com,codyswid@gmail.com?subject=Sustainabox%20Stay%20Inquiry" class="btn btn-primary" style="display: inline-block; margin: 1.5rem 0;">Request Your Stay</a>

				<p style="font-size: 0.9rem; color: var(--color-muted);">Include your preferred dates and number of guests.</p>
				<p style="font-size: 0.85rem; color: var(--color-muted); margin-top: 0.5rem;"><em>Coming soon: hello@sustainabox.org</em></p>

				<div class="booking-divider" style="margin: 2rem 0;"></div>

				<h3>Payment</h3>
				<p>We accept Venmo for deposit or full payment:</p>
				<p style="margin: 1rem 0;"><strong><a href="https://venmo.com/u/jen-swidler" rel="noopener">@jen-swidler</a></strong></p>
				<p style="font-size: 0.9rem; color: var(--color-muted);">Payment details confirmed when we receive your inquiry.</p>
			</div>

			<div class="booking-preview">
				<div class="preview-box">
					<img src="/images/deck-2.webp" alt="Sustainabox outdoor living space" style="width: 100%; border-radius: 4px; margin-bottom: 1.5rem;">
					<h3>What to Expect</h3>
					<ul>
						<li><strong>Friday evening:</strong> Arrival, orientation, dinner</li>
						<li><strong>Saturday morning:</strong> 4-hour guided walkthrough + Q&A</li>
						<li><strong>Saturday afternoon:</strong> Free time, explore, relax on deck</li>
						<li><strong>Sunday:</strong> Breakfast, discussions, depart by noon</li>
					</ul>

					<h3 style="margin-top: 2rem;">Who Should Come?</h3>
					<ul>
						<li>Builders and designers researching container homes</li>
						<li>Anyone considering alternative housing</li>
						<li>People interested in resilience and sustainable design</li>
						<li>Educators and content creators</li>
						<li>Curious learners ready to ask hard questions</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

</Layout>

<style>
	.calendar-section {
		padding: 5rem 0 3rem;
		background: var(--color-warm);
		border-bottom: 1px solid #e2e8f0;
	}

	.calendar-placeholder {
		max-width: 900px;
		margin: 0 auto;
		border: 2px dashed #cbd5e0;
		border-radius: 4px;
		background: white;
		overflow: hidden;
	}

	.calendar-placeholder-inner {
		padding: 5rem 2rem;
		text-align: center;
		color: var(--color-muted);
	}

	.calendar-icon {
		font-size: 3rem;
		margin-bottom: 1rem;
	}

	.calendar-placeholder-inner p {
		margin: 0.5rem 0;
	}

	.calendar-placeholder-inner strong {
		color: var(--color-navy);
		font-size: 1.1rem;
	}

	/* When Jenna replaces the placeholder with the real iframe, these styles apply */
	.calendar-placeholder iframe {
		width: 100%;
		height: 600px;
		border: none;
		display: block;
	}

	.content-section {
		padding: 4rem 0;
	}

	.booking-wrapper {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		max-width: 1200px;
		margin: 0 auto;
	}

	.booking-info h2 {
		margin-bottom: 1.5rem;
	}

	.booking-info p {
		color: var(--color-muted);
		margin-bottom: 1rem;
		line-height: 1.7;
	}

	.price-display {
		font-size: 2.2rem;
		font-weight: 700;
		color: var(--color-blue);
		font-family: var(--font-heading);
		margin: 0.5rem 0 0.25rem;
	}

	.booking-info ul {
		list-style: none;
		padding: 0;
		margin: 1.5rem 0;
	}

	.booking-info li {
		padding: 0.5rem 0;
		padding-left: 1.5rem;
		position: relative;
		color: var(--color-muted);
	}

	.booking-info li::before {
		content: "✓";
		position: absolute;
		left: 0;
		color: var(--color-blue);
		font-weight: bold;
	}

	.booking-divider {
		height: 1px;
		background: #e2e8f0;
		margin: 2rem 0;
	}

	.booking-preview {
		position: sticky;
		top: 100px;
		height: fit-content;
	}

	.preview-box {
		background: white;
		padding: 2rem;
		border: 1px solid #e2e8f0;
		border-radius: 4px;
	}

	.preview-box h3 {
		color: var(--color-navy);
		margin-bottom: 1rem;
		font-size: 1.15rem;
	}

	.preview-box ul {
		list-style: none;
		padding: 0;
	}

	.preview-box li {
		padding: 0.6rem 0;
		color: var(--color-muted);
		font-size: 0.9rem;
		line-height: 1.6;
		border-bottom: 1px solid #f0f0f0;
	}

	.preview-box li:last-child {
		border-bottom: none;
	}

	@media (max-width: 768px) {
		.booking-wrapper {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.booking-preview {
			position: static;
		}

		.calendar-placeholder-inner {
			padding: 3rem 1.5rem;
		}
	}
</style>
